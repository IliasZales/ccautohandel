---
import { getEntry } from "astro:content";
import Honeypot from "./forms/Honeypot.astro";

interface Feld {
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "number" | "textarea" | "select";
  required?: boolean;
  autocomplete?: string;
  options?: string[];
  hint?: string;
  half?: boolean;
}

interface Props {
  id: string;
  betreff: string;
  felder: Feld[];
  button: string;
  zusage?: string;
}

const { id, betreff, felder, button, zusage } = Astro.props;
const entry = await getEntry("settings", "index");
const { formbase } = entry!.data;
const action = formbase ? `https://submit-form.com/${formbase}` : undefined;
---

<form {id} method="post" action={action} class="grid gap-4 sm:grid-cols-2">
  <input type="hidden" name="_email.subject" value={betreff} />
  <Honeypot />
  {
    felder.map((f) => {
      const fid = `${id}-${f.name}`;
      const full = !f.half;
      const base =
        "mt-1 block w-full min-h-12 border-2 border-graphit bg-sheet px-3 py-2 text-base focus:border-pen";
      return (
        <div class:list={[full && "sm:col-span-2"]}>
          <label for={fid} class="font-semibold">
            {f.label}
            {!f.required && <span class="font-normal text-graphit-soft"> (optional)</span>}
          </label>
          {f.hint && <p id={`${fid}-hint`} class="text-sm text-graphit-soft">{f.hint}</p>}
          {f.type === "textarea" ? (
            <textarea id={fid} name={f.name} rows="4" required={f.required} class={base} aria-describedby={f.hint ? `${fid}-hint` : undefined} />
          ) : f.type === "select" ? (
            <select id={fid} name={f.name} required={f.required} class={base}>
              <option value="">Bitte wählen</option>
              {f.options?.map((o) => <option value={o}>{o}</option>)}
            </select>
          ) : (
            <input id={fid} name={f.name} type={f.type ?? "text"} required={f.required} autocomplete={f.autocomplete} class={base} aria-describedby={f.hint ? `${fid}-hint` : undefined} />
          )}
        </div>
      );
    })
  }
  <div class="sm:col-span-2">
    <label class="flex items-start gap-3">
      <input type="checkbox" name="datenschutz" required class="mt-1 size-5 accent-pen" />
      <span class="text-sm">
        Ich habe die <a href="/datenschutz" class="underline underline-offset-4">Datenschutzerklärung</a> gelesen. Meine Angaben dürfen zur Beantwortung der Anfrage verwendet werden.
      </span>
    </label>
  </div>
  <div class="sm:col-span-2">
    <button type="submit" class="btn btn-primary" disabled={!action}>{button}</button>
    {zusage && <p class="mt-3 text-sm text-graphit-soft">{zusage}</p>}
    {
      !action && (
        <p class="mt-3 border-l-4 border-gauge bg-gauge/20 p-3 text-sm" role="status">
          Das Formular wird mit der Einrichtung des E-Mail-Versands aktiv. Bis dahin: bitte anrufen oder per WhatsApp schreiben.
        </p>
      )
    }
  </div>
</form>
