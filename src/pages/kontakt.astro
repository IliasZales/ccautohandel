---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Formular from "../components/Formular.astro";
import Offen from "../components/Offen.astro";

const s = await getEntry("settings", "index");
const { adress, hours, phone, phoneDisplay, whatsapp, email, mapUrl } = s!.data;
const tel = phone ? `tel:${phone}` : undefined;
const wa = whatsapp ? `https://wa.me/${whatsapp.replace(/\D/g, "")}` : undefined;
---

<Layout title="Kontakt und Anfahrt – C&C Autozentrum" description="Adresse, Öffnungszeiten, Telefon und WhatsApp von C&C Autozentrum.">
  <PageHeader eyebrow="Kontakt" title="Kommen Sie vorbei oder rufen Sie an." lead="Am schnellsten erreichen Sie uns telefonisch oder per WhatsApp. Auf dem Hof sind Sie jederzeit zu den Öffnungszeiten willkommen." />

  <section class="wrap grid gap-10 py-16 lg:grid-cols-2">
    <div>
      <address class="not-italic">
        <h2 class="text-3xl narrow">Hof</h2>
        <p class="mt-2 text-lg">C&amp;C Autozentrum GbR<br /><Offen>{adress.street}</Offen><br /><Offen>{adress.zip} {adress.city}</Offen></p>
        <h2 class="mt-8 text-3xl narrow">Öffnungszeiten</h2>
        <p class="mt-2 text-lg"><Offen>{hours}</Offen></p>
        <h2 class="mt-8 text-3xl narrow">Direkt erreichen</h2>
        <div class="mt-3 flex flex-wrap gap-3">
          <a href={tel ?? "#formular"} class="btn btn-primary"><span class="font-mono text-sm">{phoneDisplay}</span></a>
          <a href={wa ?? "#formular"} class="btn btn-ghost">WhatsApp</a>
        </div>
        {email && <p class="mt-4 font-mono">{email}</p>}
      </address>

      <div class="mt-10 flex aspect-[16/10] flex-col items-center justify-center gap-3 border-2 border-graphit bg-carbon p-6 text-center">
        <p class="label">Anfahrt</p>
        <p class="max-w-sm">Statische Karte folgt, sobald die Adresse feststeht. So werden keine Daten an Kartendienste übertragen, bevor Sie es wünschen.</p>
        {mapUrl && <a href={mapUrl} class="btn btn-ghost" rel="noopener">Route in Google Maps öffnen</a>}
      </div>
    </div>

    <div class="self-start border-2 border-graphit bg-sheet p-6" id="formular">
      <h2 class="text-3xl narrow">Nachricht schreiben</h2>
      <div class="mt-4">
        <Formular id="kontakt" betreff="Kontaktanfrage" button="Nachricht senden" zusage="Antwort am selben Werktag." felder={[
          { name: "name", label: "Name", required: true, autocomplete: "name", half: true },
          { name: "telefon", label: "Telefon", type: "tel", autocomplete: "tel", half: true },
          { name: "email", label: "E-Mail", type: "email", autocomplete: "email" },
          { name: "nachricht", label: "Ihre Nachricht", type: "textarea", required: true },
        ]} />
      </div>
    </div>
  </section>

  <section class="bg-carbon py-16" id="suchauftrag">
    <div class="wrap grid gap-10 lg:grid-cols-2">
      <div>
        <p class="label">Fahrzeugsuche</p>
        <h2 class="mt-3 text-4xl narrow">Das richtige Auto nicht dabei? Wir suchen es.</h2>
        <p class="mt-4 text-lg">Sagen Sie uns Modell, Budget und Wünsche. Wir melden uns, sobald ein passendes Fahrzeug hereinkommt, auch wenn es noch nicht inseriert ist.</p>
      </div>
      <div class="border-2 border-graphit bg-sheet p-6">
        <Formular id="suche" betreff="Suchauftrag" button="Suchauftrag aufgeben" felder={[
          { name: "wunsch", label: "Was suchen Sie?", type: "textarea", required: true, hint: "Modell, Baujahr, Kraftstoff, Budget." },
          { name: "name", label: "Name", required: true, autocomplete: "name", half: true },
          { name: "telefon", label: "Telefon", type: "tel", required: true, autocomplete: "tel", half: true },
        ]} />
      </div>
    </div>
  </section>
</Layout>
