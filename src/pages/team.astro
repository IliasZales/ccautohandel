---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import DynamicImage from "../components/utils/DynamicImage.astro";
import Offen from "../components/Offen.astro";
import { IMAGES } from "../data/images";
import { TEAM } from "../data/team";
---

<Layout title="Team – C&C Autozentrum" description="Die Menschen hinter C&C Autozentrum: Gesellschafter, Verkauf und Werkstatt.">
  <PageHeader
    eyebrow="Team"
    title="Diese Menschen stehen hinter jedem Verkauf."
    lead="C&C Autozentrum ist eine GbR. Die Gesellschafter haften persönlich, deshalb steht hier, wer sie sind."
  />

  <section class="wrap py-12">
    <DynamicImage src={IMAGES.team.file} alt={IMAGES.team.alt} isAi={IMAGES.team.isAi} classes="aspect-[16/9] w-full border-2 border-graphit object-cover" />
  </section>

  <section class="wrap pb-12">
    <ul class="grid gap-6 md:grid-cols-3" role="list">
      {TEAM.map((p) => (
        <li class="border-2 border-graphit bg-sheet">
          <div class="flex aspect-[4/3] items-center justify-center border-b-2 border-graphit bg-carbon">
            <span class="border-2 border-graphit bg-sheet px-3 py-1 font-mono text-sm">FOTO FOLGT</span>
          </div>
          <div class="p-5">
            <h2 class="text-2xl narrow"><Offen>{p.name}</Offen></h2>
            <p class="label mt-1">{p.rolle}</p>
            <p class="mt-3 text-graphit-soft">{p.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-carbon py-16">
    <div class="wrap grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-4xl narrow">Wie wir arbeiten</h2>
        <ul class="mt-5 space-y-4" role="list">
          {[
            ["Wir kaufen, was wir selbst fahren würden.", "Fahrzeuge mit unklarer Historie lehnen wir ab."],
            ["Wir sagen, was nicht in Ordnung ist.", "Mängel stehen in der Akte. Das spart beiden Seiten Streit."],
            ["Wir bleiben erreichbar.", "Nach dem Kauf gilt dieselbe Telefonnummer wie davor."],
          ].map(([t, x]) => (
            <li class="border-l-4 border-pen pl-4"><p class="font-display text-xl narrow">{t}</p><p class="text-graphit-soft">{x}</p></li>
          ))}
        </ul>
      </div>
      <p class="self-start border-l-4 border-gauge bg-gauge/20 p-4 text-sm">
        Hinweis für das Team: Diese drei Grundsätze sind ein Entwurf. Bitte streichen oder ändern, was nicht stimmt. Es steht nur drin, was ihr wirklich einhaltet.
      </p>
    </div>
  </section>
</Layout>
